# Copy to tool/web_build.env and fill in (web_build.env is gitignored).
# PowerShell: Copy-Item tool/web_build.env.example tool/web_build.env
#
# Required for flutter build web (AppEnv.fromEnvironment):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
#
# Optional (Edge Functions base URL if the app calls them):
# SUPABASE_FUNCTIONS_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1
#
# Optional (only if you test checkout flows on web):
# RAZORPAY_TEST_KEY=rzp_test_...
