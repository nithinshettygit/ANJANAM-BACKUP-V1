# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio local / generated
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties
/android/.gradle/
/android/captures/
/android/.cxx/
/android/app/.cxx/

# Firebase Hosting CLI cache
.firebase/

# Local env for web builds (copy from tool/web_build.env.example if present)
tool/web_build.env

# Web runtime Supabase config (copy from web/app-config.json.example)
web/app-config.json

# Dart/Flutter env files (secrets — use tool/web_build.env or --dart-define)
.env
.env.*
!.env.example

# Old / scratch Android build tree (not source; breaks git on Windows path length)
unused-files/

# Firebase Android client config — restore from Firebase Console; do not commit
android/app/google-services.json

# Android Play signing — never commit (use key.properties.example as template)
android/key.properties
**/*.jks
**/*.keystore
!android/key.properties.example

# Google Cloud / Firebase service account keys (private) — never commit
eco-muse*.json
*-firebase-adminsdk-*.json
*serviceAccount*.json
*service-account*.json
*.base64.txt
**/service-account*.json

# Local ADI registration payload
assets/adi-registration.properties

# Node (Supabase CLI install) — never commit
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# iOS generated / machine-local (flutter build regenerates)
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/
ios/Podfile.lock.bak

# macOS generated
macos/Flutter/ephemeral/
macos/Pods/

# Windows / Linux ephemeral
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Test / coverage / misc tooling
coverage/
*.lcov
.mcp/
*.canvas.tsx.bak

# Large local dumps / archives
*.apk
*.aab
*.ipa
*.dSYM.zip
*.symbols.zip

# Cursor local skill state / agent scratch (if nested under app)
.cursor/
*.canvas.local.tsx
