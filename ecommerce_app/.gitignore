# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Hosting CLI cache
.firebase/

# Local env for web builds (copy from tool/web_build.env.example)
tool/web_build.env

# Dart/Flutter env files (secrets — use tool/web_build.env or --dart-define)
.env
.env.*
!.env.example

# Old / scratch Android build tree (not source; breaks git on Windows path length)
unused-files/

# Firebase Android client config — restore from Firebase Console; do not commit
android/app/google-services.json

# Google Cloud service account keys (private keys) — never commit
eco-muse*.json
*.base64.txt
